# Public URL of the app, no trailing slash. http://localhost:3000 locally.
APP_URL=http://localhost:3000

# Postgres. On Supabase use the transaction pooler URL (port 6543) here...
DATABASE_URL=postgres://app:app@localhost:5432/slashbot
# ...and the session/direct URL (port 5432) here for migrations. Optional locally.
DATABASE_URL_DIRECT=

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-random-string-at-least-32-chars
# openssl rand -base64 32  (must decode to exactly 32 bytes)
ENCRYPTION_KEY=
# openssl rand -hex 24. Shared with the Supabase cron job that calls /api/jobs/sweep.
CRON_SECRET=

# Discord Developer Portal > your app
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=

# Optional. Without it, AI triage is skipped and reports post without a summary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

LOG_LEVEL=info

# Optional. When both are set, each build creates this admin (or resets its password).
# Handy for the first deploy; remove them afterwards if you like.
ADMIN_EMAIL=
ADMIN_PASSWORD=
