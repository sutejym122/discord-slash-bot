{
  "name": "discord-slash-bot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "biome check && tsc --noEmit && vitest run",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "simulate": "tsx scripts/simulate.ts",
    "vercel-build": "tsx scripts/migrate.ts && tsx --conditions=react-server scripts/register-commands.ts && tsx --conditions=react-server scripts/create-admin.ts --from-env && next build",
    "discord:register": "tsx --conditions=react-server scripts/register-commands.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.28.0",
  "type": "module"
}
